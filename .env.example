NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/tikvoice
REDIS_URL=redis://localhost:6379

# Google Gemini API Key & Model (@google/genai)
# Miễn phí cao nhất: gemini-2.5-pro (hoặc gemini-2.0-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# Google Cloud TTS (Tùy chọn)
GOOGLE_APPLICATION_CREDENTIALS=

# Đường dẫn thư mục lưu trữ media
STORAGE_PATH=./storage

# Giới hạn số render đồng thời (Khuyên dùng: 1 cho VPS 2 vCPU, 2 cho VPS >= 4 vCPU)
MAX_CONCURRENT_RENDERS=1
