NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/tikvoice
REDIS_URL=redis://localhost:6379

# Google Gemini API Key (@google/genai)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud TTS (Tùy chọn)
GOOGLE_APPLICATION_CREDENTIALS=

# Đường dẫn thư mục lưu trữ media
STORAGE_PATH=./storage

# Giới hạn số render đồng thời (Khuyên dùng: 1 cho VPS 2 vCPU, 2 cho VPS >= 4 vCPU)
MAX_CONCURRENT_RENDERS=1
